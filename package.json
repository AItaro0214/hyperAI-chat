{
  "name": "hyperai-chat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute DB --remote --file=./migrations/0001_init.sql",
    "db:init:local": "wrangler d1 execute DB --local --file=./migrations/0001_init.sql",
    "seed": "node scripts/bootstrap.mjs",
    "unlock": "wrangler d1 execute DB --remote --command \"UPDATE users SET failed_attempts=0, locked_at=NULL\"",
    "tail": "wrangler tail",
    "test:api": "node tests/api.mjs",
    "test:flows": "node tests/flows.mjs",
