    "test:discount": "node tests/discount.mjs",
    "test:media": "node tests/media.mjs",
    "test:docs": "node tests/docs.mjs",
    "test:office": "node tests/office-unit.mjs",
    "test:visual": "node tests/visual-unit.mjs",
    "test:agent": "node tests/agent-unit.mjs",
    "test:deck": "node tests/deck-probe.mjs",
    "test:docsunit": "node tests/docs-unit.mjs",
    "test:tts": "node tests/tts-unit.mjs",
    "test:msg": "node tests/msg-unit.mjs",
    "test:video": "node tests/video-unit.mjs",
    "test:effort": "node tests/effort-unit.mjs",
